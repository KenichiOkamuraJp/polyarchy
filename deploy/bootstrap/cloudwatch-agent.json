{
  "agent": {"region": "ap-northeast-1", "run_as_user": "root"},
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/polyarchy/polyarchy-mcp.log",
            "log_group_name": "polyarchy/mcp",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 30,
            "timezone": "UTC"
          },
          {
            "file_path": "/var/log/polyarchy/polyarchy-stats.log",
            "log_group_name": "polyarchy/stats",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 30,
            "timezone": "UTC"
          },
          {
            "file_path": "/var/log/polyarchy/polyarchy-companies.log",
            "log_group_name": "polyarchy/companies",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 30,
            "timezone": "UTC"
          },
          {
            "file_path": "/var/log/polyarchy/polyarchy-dataapply.log",
            "log_group_name": "polyarchy/dataapply",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 30,
            "timezone": "UTC"
          }
        ]
      }
    }
  }
}
