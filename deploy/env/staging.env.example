# ── staging（自分AWS・構築/検証・web+mcp）───────────────────────────────────
# 環境ごとの「非秘密」パラメータの単一の真実。秘密は値ではなく“在り処”を指すだけ。
# 使い方: cp env/staging.env.example env/staging.env して編集（env/*.env は .gitignore 済）。
# これを deploy.sh / register-secrets.sh が読む＝staging と prod の差はこのファイルだけ。

ENVIRONMENT=staging
AWS_PROFILE=polyarchy-staging
AWS_REGION=ap-northeast-1
# S3 バケット名（任意）。release.sh／triage.sh は BUCKET があればそれを使い、無ければ terraform output から取る。
# terraform state を持たないフォルダ（配布用のクローン・定型更新だけの運用者）から配布するときに書く。
# BUCKET=

# web(chat_app) は廃止（2026-09-02）＝staging も false（MCPのみ・ランタイム秘密ゼロ＝prod と同型）。コードは残置。
ENABLE_WEB_APP=false

# 入口（Cloudflare Tunnel）。既存トンネルを Mac→EC2 へ移設（DNS は UUID 向きで不変）。
TUNNEL_ID=<TUNNEL_UUID>   # 例: xxxxxxxx-…（staging は既存トンネルの UUID）
TUNNEL_HOST_MCP=recommendations.polyarchy.net
TUNNEL_HOST_WEB=                                   # web 廃止（2026-09-02）＝空
# stats（統計参照DB・別プロセス :8766）。2026-08-28 から配信中。
ENABLE_STATS_APP=true
TUNNEL_HOST_STATS=stats.polyarchy.net
# companies（企業情報DB・別プロセス :8767）。opt-in＝true にすると release.sh のゲートが 9→13 本になり、値の置き場（companies/data/store）も配布される。
# ★稼働中の箱は user_data を再実行しない＝箱の /etc/polyarchy/deploy.env にも同じ 2 行を足す（RUNBOOK §5「サービスを足す」）。
ENABLE_COMPANIES_APP=false
TUNNEL_HOST_COMPANIES=companies.polyarchy.net
# deliberations（審議会議事録DB・別プロセス :8768＋専用 Qdrant :6340）。opt-in＝true にすると release.sh に 4 ゲート＋束の書き出しが足され、
# 束（S3 data/deliberations/bundle/）も配布される。手元に審議会DB の Qdrant（qdrant-delib）と解析結果が要る（deliberations/CLAUDE.md）。
# ★自動適用のスクリプトの変更は次の次の配布から効く＝有効化は配線入りのコードを 1 回配布した後（RUNBOOK §5）。
ENABLE_DELIBERATIONS_APP=false
TUNNEL_HOST_DELIBERATIONS=deliberations.polyarchy.net
# MCP 4 本の待受アドレス（terraform var mcp_http_host → deploy.env）。既定 127.0.0.1＝トンネル経由だけ。通常は書かない。
# MCP_HTTP_HOST=127.0.0.1

# 秘密の“在り処”（値は書かない）。register-secrets.sh が読んで SSM SecureString へ入れる。
CLOUDFLARED_CRED_FILE=$HOME/.cloudflared/<TUNNEL_UUID>.json

# Anthropic キーの取得元（ENABLE_WEB_APP=true の時だけ使用）。次のいずれか:
#   file:<path>   … その .env から ANTHROPIC_API_KEY= を読む
#   env:VARNAME   … 既に export 済みの環境変数から
#   prompt        … 実行時に対話で聞く（画面にもシェル履歴にも残さない）
ANTHROPIC_SOURCE=file:<REPO>/recommendations/.env   # 例: file:/Users/you/polyarchy/recommendations/.env

# OpenAI キーの取得元（★staging のみ・任意）。eval ゲート（--retrieval-only 等）が OPENAI_API_KEY の
# 存在チェックを持つため（実検索は ruri ローカルで OpenAI 実呼び出しは無し）。serving では未使用。
# prod では設定しない＝prod はランタイム秘密ゼロを維持。書式は ANTHROPIC_SOURCE と同じ。
OPENAI_SOURCE=file:<REPO>/recommendations/.env

# e-Stat appId の取得元（stats の更新チェック＝箱の freshness が e-Stat 系を検知するため・任意）。書式は同上。
# 環境ごとに取得する（staging＝開発者本人の appId。prod＝導入団体が取得したもの）。
ESTAT_SOURCE=file:<REPO>/stats/.env

# Cloudflare Access Managed OAuth（案 A）＝2026-09-02 に案 B（外部 IdP・下記 AUTH_*）を採択したため**現行未使用**（資産温存・空のまま）。
#   ACCESS_TEAM_DOMAIN … Zero Trust チームドメイン（例 xxxx.cloudflareaccess.com）
#   ACCESS_AUD_STATS   … Access アプリ polyarchy の Application Audience(AUD) タグ → stats.env に MCP_ACCESS_*（stats を OAuth 必須に）
#   ACCESS_AUD_MCP     … 同 AUD → mcp.env（recommendations も OAuth 必須にする時だけ設定。未設定なら recommendations は従来どおり）
# 空なら何もしない（従来どおり素の HTTP＋秘密パス＝公開 DB の標準・2026-08-28 決定）。
ACCESS_TEAM_DOMAIN=
ACCESS_AUD_STATS=
ACCESS_AUD_MCP=

# 外部 IdP（個人認証・案 B＝docs/個人認証_案B設計.md。名簿限定の入口はこちら）。
#   AUTH_ISSUER    … IdP の issuer URL（例 https://xxxx.authkit.app）。トークンの iss と完全一致で書く（Auth0 は末尾スラッシュ付き）
#   AUTH_AUD_STATS … stats 用の aud → stats.env に MCP_AUTH_*
#   AUTH_AUD_MCP   … recommendations 用 → mcp.env
#   AUTH_AUD_COMPANIES … companies 用 → companies.env
#   AUTH_AUD_DELIBERATIONS … deliberations 用 → deliberations.env
# ★公開する（トンネルがあり TUNNEL_HOST_<SVC> がある）サービスは必須＝無ければ bootstrap ⑧ が FAIL して配布が切り戻る
#   （利用者はログイン必須・ルート CLAUDE.md §3）。resource URL は bootstrap が TUNNEL_HOST_<SVC>＋秘密パスから合成。
AUTH_ISSUER=
AUTH_AUD_STATS=
AUTH_AUD_MCP=
AUTH_AUD_COMPANIES=
AUTH_AUD_DELIBERATIONS=

# recommendations の検索構成（terraform var → deploy.env の COLLECTION_NAME/VECTOR_BACKEND → systemd）。
# 空＝既定の v7/qdrant（本線・2026-08-28 切替。bootstrap が Qdrant を導入し data/qdrant は S3 経由で配布）。
# 切り戻しは Qdrant 内のコレクション切替のみ＝RECOMMENDATIONS_COLLECTION_NAME=policy_claims_v6
# （Chroma 経路は 2026-08-28 全廃＝qdrant 以外はアプリが起動時エラー）。
# 名前に RECOMMENDATIONS_ を付けるのはシェルの COLLECTION_NAME 混入防止。
RECOMMENDATIONS_COLLECTION_NAME=
RECOMMENDATIONS_VECTOR_BACKEND=

# アラーム通知（SNS→メール・docs/運用設計.md）。空＝購読なし（トピック/アラームは作られる）。
# 設定するとメールに AWS からの Confirm リンクが届く＝クリックで購読有効化。
ALERT_EMAIL=
