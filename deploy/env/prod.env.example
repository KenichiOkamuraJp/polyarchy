# ── prod（導入団体 AWS・MCPのみ・ランタイム秘密ゼロ）───────────────────────────
# staging と“同じスクリプト”をこのファイルで転写する（仕様§3.1）。差し替えは下記だけ。
# 使い方: cp env/prod.env.example env/prod.env して編集 → deploy.sh prod all。

ENVIRONMENT=prod
AWS_PROFILE=adopter-prod          # 事前に aws configure --profile adopter-prod（導入団体 AWSのアクセス手段）
AWS_REGION=ap-northeast-1
# S3 バケット名（任意）。release.sh／triage.sh は BUCKET があればそれを使い、無ければ terraform output から取る。
# BUCKET=

ENABLE_WEB_APP=false              # ★prod は web 無し = Anthropic 不要 = ランタイム秘密ゼロ

# 入口＝導入団体ゾーンで新規に作るトンネル（別UUID）。①入口=導入団体の独自ドメイン。
TUNNEL_ID=REPLACE_WITH_ADOPTER_TUNNEL_UUID
TUNNEL_HOST_MCP=recommendations.REPLACE_WITH_ADOPTER_DOMAIN   # ★命名は stats./recommendations.（mcp. という名は 2026-09-02 廃止）
TUNNEL_HOST_WEB=                 # 未使用（web 無し）
ENABLE_STATS_APP=true            # ②導入団体展開は stats＋recommendations の 2 サービス（PROD_MIGRATION §3）
TUNNEL_HOST_STATS=stats.REPLACE_WITH_ADOPTER_DOMAIN
ENABLE_COMPANIES_APP=false       # 企業情報DB（companies）は opt-in。使うなら true＋下のホスト名＋AUTH_AUD_COMPANIES（書式は staging.env.example）
TUNNEL_HOST_COMPANIES=companies.REPLACE_WITH_ADOPTER_DOMAIN

CLOUDFLARED_CRED_FILE=$HOME/.cloudflared/REPLACE_WITH_ADOPTER_TUNNEL_UUID.json

# ANTHROPIC_SOURCE は書かない（ENABLE_WEB_APP=false なので登録もされない）。
# e-Stat appId（導入団体が本人登録で取得したもの。箱の更新チェックが e-Stat 系の改定を検知するのに要る）。
ESTAT_SOURCE=file:/path/to/adopter-estat.env      # その中に ESTAT_APP_ID=… の 1 行（git 外・値はここに書かない）
# 入口（秘密パス＋レート制限）は Cloudflare 側で設定（README §9・Terraform 管理外・guard は IP_ALLOWLIST=off＝IP 許可は 2026-08-28 廃止）。

# Cloudflare Access Managed OAuth（案 A）＝現行未使用（2026-09-02 案 B 採択）。空のまま。
ACCESS_TEAM_DOMAIN=
ACCESS_AUD_STATS=
ACCESS_AUD_MCP=

# 外部 IdP（個人認証・案 B＝docs/個人認証_案B設計.md）。導入団体向けは導入団体用 IdP テナント（名簿限定）を指す。
# 書式・挙動は staging.env.example と同じ（AUTH_AUD_<SVC> がサービス毎の有効化スイッチ）。
AUTH_ISSUER=
AUTH_AUD_STATS=
AUTH_AUD_MCP=
AUTH_AUD_COMPANIES=

# recommendations の検索構成（terraform var → deploy.env の COLLECTION_NAME/VECTOR_BACKEND → systemd）。
# 空＝既定の v7/qdrant（本線・2026-08-28 切替。bootstrap が Qdrant を導入し data/qdrant は S3 経由で配布）。
# 切り戻しは Qdrant 内のコレクション切替のみ＝RECOMMENDATIONS_COLLECTION_NAME=policy_claims_v6
# （Chroma 経路は 2026-08-28 全廃＝qdrant 以外はアプリが起動時エラー）。
# 名前に RECOMMENDATIONS_ を付けるのはシェルの COLLECTION_NAME 混入防止。
RECOMMENDATIONS_COLLECTION_NAME=
RECOMMENDATIONS_VECTOR_BACKEND=

# アラーム通知（SNS→メール・docs/運用設計.md）。空＝購読なし（トピック/アラームは作られる）。
# 設定するとメールに AWS からの Confirm リンクが届く＝クリックで購読有効化。
ALERT_EMAIL=
