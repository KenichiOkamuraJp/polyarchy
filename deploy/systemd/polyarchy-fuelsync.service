# 捕捉ログ（＝「燃料」・実運用の実質問）を S3 へバックアップ。S3 versioning ON で誤削除/上書きから
# 保護（仕様§4.1）。oneshot＝timer から定期起動。EBS が主・S3 は保護コピー（--delete は付けない）。
[Unit]
Description=Polyarchy 捕捉ログ(燃料)の S3 バックアップ
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=polyarchy
Group=polyarchy
# S3_BUCKET/DATA_S3_PREFIX/AWS_REGION は user_data 生成の deploy.env から。
EnvironmentFile=/etc/polyarchy/deploy.env
# 3 サービスの同期と結果の記録は /usr/local/bin/polyarchy-fuelsync（deploy/bootstrap/fuelsync.sh）。無いフォルダは飛ばし、
# 同期の失敗は unit の failed として残す（旧＝-ExecStart で失敗を無視し、運用側から見えなかった・2026-10-01）。
# 結果＝ops/dashboard/fuelsync/（運用ダッシュボード①の「捕捉ログの S3 同期」）。
ExecStart=/usr/local/bin/polyarchy-fuelsync
StandardOutput=journal
StandardError=journal
