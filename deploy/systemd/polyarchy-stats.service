# Polyarchy 統計参照DB（stats）の MCP サーバ——recommendations とは別プロセス・別ホスト名（B6 案 B）。
#   python -m stats.serving.mcp_server --http --port 8766
# 層＝公開固定・fail-closed（該当なしは「ない」と返す）。モデル不要・軽量。127.0.0.1 バインドで直露出しない。
# 設置は bootstrap ⑧（ENABLE_STATS_APP=true のとき）。入口は cloudflared ingress の stats.<domain> → :8766。
[Unit]
Description=Polyarchy stats MCP server (Streamable HTTP :8766, layer=public fixed, fail-closed)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=polyarchy
Group=polyarchy
WorkingDirectory=/opt/polyarchy/polyarchy
EnvironmentFile=-/etc/polyarchy/deploy.env
# 秘密パス（MCP_HTTP_PATH=/mcp-<乱数>）＋認証（MCP_AUTH_*＝案 B・外部 IdP）。
# bootstrap が SSM stats_http_path / auth_aud_stats から生成（パスが無ければ既定 /mcp。公開ホストがあるのに認証が無ければ bootstrap が FAIL）。
EnvironmentFile=-/etc/polyarchy/stats.env
Environment=PYTHONPATH=/opt/polyarchy/polyarchy
Environment=STATS_QUERY_LOG=/opt/polyarchy/polyarchy/stats/data/query_log/queries.jsonl
# Environment=MCP_ALLOWED_HOSTS=stats.<domain>,127.0.0.1:8766
# 待受アドレスは MCP_HTTP_HOST（deploy.env・無ければ 127.0.0.1＝直露出しない）。ポートは cloudflared ingress・health と対なのでここで固定。
# 封じ込め（B46 (a)・2026-10-19）＝権限の昇格を封じ、コード・Python 環境・設定・モデルは読むだけにする。書ける先は
# 捕捉ログのフォルダだけ（実行中に書くのは polyarchy_common/capture.py の 1 か所・モデルは HF_HUB_OFFLINE で読むだけ）。
# /tmp はこのサービス専用。★実行中に書く先を足したら ReadWritePaths にも足す（足さないと Read-only file system＝
# 捕捉ログは fail-open なので黙って書けなくなる）。フォルダは bootstrap が先に作る（無いと起動しない）。test_common が突き合わせる。
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/polyarchy/polyarchy/stats/data/query_log
ExecStart=/opt/miniconda/envs/polyarchy/bin/python -m stats.serving.mcp_server --http --port 8766
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
# rsyslog がサービス別ファイル（/var/log/polyarchy/<identifier>.log）へ振り分ける鍵（運用設計 §1.2・CW Logs 転送）。
SyslogIdentifier=polyarchy-stats

[Install]
WantedBy=multi-user.target
