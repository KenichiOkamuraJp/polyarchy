{"id": "q-streak-up-10", "conditions": [{"metric": "top_line", "aggregate": "streak_up", "min": 10}], "period_from": "2015-01", "period_to": "2025-12", "as_of": "2026-09-30", "limit": 100, "expect": {"excluded_include": ["standard_changed", "insufficient_history"], "note_includes": ["収益認識", "restated"]}, "note": "10 年連続増収＝11 年の系列で連続増加 10 回。基準の変わった会社・上場から年が足りない会社は除外の理由で返る・収益認識基準の注"}
{"id": "q-cagr-nonmfg", "conditions": [{"metric": "top_line", "aggregate": "cagr"}], "manufacturing": false, "period_from": "2016-01", "period_to": "2025-12", "as_of": "2026-09-30", "limit": 20, "expect": {"sorted": true, "max_rows": 20, "no_manufacturing": true}, "note": "売上の年平均成長率の上位・非製造業"}
{"id": "q-roe-years", "conditions": [{"metric": "roe", "aggregate": "years_meeting", "year_min": 0.08, "min": 10}], "period_from": "2016-01", "period_to": "2025-12", "as_of": "2026-09-30", "limit": 100, "expect": {"excluded_include": ["insufficient_history"]}, "note": "ROE が 10 年間すべて 0.08 以上（年の条件は year_min・会社の条件は min）"}
{"id": "q-total-assets-double", "conditions": [{"metric": "total_assets", "aggregate": "ratio", "min": 2}], "period_from": "2016-01", "period_to": "2025-12", "as_of": "2026-09-30", "limit": 50, "expect": {"sorted": true}, "note": "総資産が 10 年で 2 倍以上"}
{"id": "q-eps-split", "conditions": [{"metric": "eps_basic", "aggregate": "cagr"}], "period_from": "2016-01", "period_to": "2025-12", "as_of": "2026-09-30", "limit": 20, "expect": {"excluded_include": ["stock_split"]}, "note": "1 株当たりの項目は株式分割の年をまたぐと除外"}
{"id": "q-and", "conditions": [{"metric": "top_line", "aggregate": "cagr", "min": 0.05}, {"metric": "roe", "aggregate": "years_meeting", "year_min": 0.1, "min": 8}], "order_by": "cagr:top_line", "period_from": "2016-01", "period_to": "2025-12", "as_of": "2026-09-30", "limit": 20, "expect": {"sorted": true, "max_rows": 20}, "note": "2 つの条件の AND・並べる集約は order_by"}
{"id": "q-default-window", "conditions": [{"metric": "top_line", "aggregate": "streak_down", "min": 3}], "as_of": "2026-09-30", "limit": 10, "expect": {"max_rows": 10, "same_span": true}, "note": "期間の指定なし＝収録の最古〜最新"}
{"id": "q-default-window-cagr", "conditions": [{"metric": "top_line", "aggregate": "cagr"}], "as_of": "2026-09-30", "limit": 20, "expect": {"sorted": true, "same_span": true, "excluded_include": ["insufficient_history"]}, "note": "期間の指定なし＝置き場で最も古い決算期〜基準日を全社で使う（会社ごとの最古からにすると、2〜3 年の会社が年平均成長率の上位に並んだ＝2026-09-30 実装時）"}
{"id": "q-default-window-roa", "conditions": [{"metric": "roa", "aggregate": "mean", "min": 0.05}], "as_of": "2026-09-30", "limit": 20, "expect": {"sorted": true, "same_span": true}, "note": "期のずれのある式は、期間の既定では入力がそろう最古の年から（最初の年だけ落ちる＝全社で同じ）"}
{"id": "q-unknown-aggregate", "conditions": [{"metric": "top_line", "aggregate": "median"}], "as_of": "2026-09-30", "expect": {"reason": "unknown_aggregate"}, "note": "語彙に無い集約は受けない"}
{"id": "q-no-aggregate", "conditions": [{"metric": "top_line"}], "as_of": "2026-09-30", "expect": {"reason": "bad_request"}, "note": "集約の指定が要る（1 年の条件は screen_companies）"}
{"id": "q-years-meeting-no-threshold", "conditions": [{"metric": "roe", "aggregate": "years_meeting", "min": 5}], "as_of": "2026-09-30", "expect": {"reason": "bad_request"}, "note": "years_meeting は year_min か year_max が要る"}
{"id": "q-bad-period", "conditions": [{"metric": "top_line", "aggregate": "cagr"}], "period_from": "2016", "as_of": "2026-09-30", "expect": {"reason": "bad_period"}, "note": "期間は決算期末の YYYY-MM"}
{"id": "q-not-ingested", "conditions": [{"metric": "operating_profit", "aggregate": "cagr"}], "as_of": "2026-09-30", "expect": {"reason": "input_not_ingested", "unavailable_include": [{"term": "operating_profit", "level": "input_not_ingested"}]}, "note": "未収録の項目＝第 1c 便と同じ 3 段"}
{"id": "q-limit", "conditions": [{"metric": "top_line", "aggregate": "cagr"}], "limit": 500, "as_of": "2026-09-30", "expect": {"reason": "bad_request"}, "note": "limit は 1〜100"}
{"id": "q-order-by", "conditions": [{"metric": "top_line", "aggregate": "cagr"}], "order_by": "roe", "as_of": "2026-09-30", "expect": {"reason": "bad_request"}, "note": "order_by は条件の名前（<aggregate>:<metric>）"}
